# Copy to .env in this folder (it is git-ignored) and fill in:
#   cp penpot.env.example .env
#
# A long random secret from which Penpot derives its session and invitation keys:
#   openssl rand -base64 48
PENPOT_SECRET_KEY=
# The database password: anything long and random.
#   openssl rand -hex 24
PENPOT_DB_PASSWORD=
# The Penpot version to run (the images and the compose file are 2.18's).
PENPOT_VERSION=2.18
