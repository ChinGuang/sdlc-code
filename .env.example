# Nebius Token Factory API key (used for inference and Sandboxes)
NEBIUS_API_KEY=
# Nebius project ID, sent as the `Project` header to the Sandboxes API
NEBIUS_AI_PROJECT=
# Optional override, default https://api.tokenfactory.nebius.com/sandboxes/v1
NEBIUS_SANDBOX_URL=
# Optional override, default https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=
# Penpot MCP endpoint incl. userToken (Penpot > Integrations > MCP)
PENPOT_MCP_URL=
# Optional: local server port (always bound to 127.0.0.1), default 4317
SDLC_CODE_PORT=
