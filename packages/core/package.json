    "penpot:smoke": "tsx --env-file-if-exists=../../.env scripts/penpotSmoke.ts",
    "penpot:probe": "tsx --env-file-if-exists=../../.env scripts/penpotSuspendProbe.ts"
  },
  "dependencies": {
    "@sdlc-code/clients": "workspace:*",
    "@sdlc-code/stack-profiles": "workspace:*",
    "@seriousme/openapi-schema-validator": "^2.10.0",
    "better-sqlite3": "^13.0.3",
    "linkedom": "^0.18.13",
    "mermaid": "^11.17.2",
    "yaml": "^2.9.1",
