// The Walking Skeleton ships one table so the database is real from Slice 1.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppInfo {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}
